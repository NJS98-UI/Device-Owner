<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Cam" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- 深灰色配色方案 -->
        <item name="colorPrimary">#424242</item>
        <item name="colorPrimaryVariant">#2A2A2A</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#616161</item>
        <item name="colorSecondaryVariant">#424242</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="android:colorBackground">#1A1A1A</item>
        <item name="colorSurface">#2A2A2A</item>
        <item name="colorOnSurface">#FFFFFF</item>
        <item name="android:statusBarColor">#2A2A2A</item>
        <item name="android:navigationBarColor">#000000</item>
        <!-- 启动画面背景颜色（偏蓝色） -->
        <item name="android:windowBackground">@color/page_background</item>
        <!-- Android 12+ 启动画面背景 -->
        <item name="android:windowSplashScreenBackground">@color/page_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
    </style>

    <style name="Theme.Cam" parent="Base.Theme.Cam" />

    <!-- 全屏播放器主题 -->
    <style name="Theme.Cam.Fullscreen" parent="Theme.Cam">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
    </style>

    <!-- 完全透明主题（用于开机自启动） -->
    <style name="Theme.Cam.Transparent" parent="Theme.Cam">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowDisablePreview">true</item>
    </style>

    <!-- 导航菜单项文字样式 -->
    <style name="NavigationMenuTextAppearance" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/nav_text_primary</item>
        <item name="fontFamily">sans-serif-medium</item>
    </style>

    <!-- 导航视图样式 -->
    <style name="NavigationViewStyle">
        <item name="itemBackground">@drawable/nav_item_background</item>
        <item name="itemIconTint">@color/nav_icon_tint</item>
        <item name="itemTextColor">@color/nav_text_primary</item>
        <item name="itemShapeFillColor">@android:color/transparent</item>
        <item name="itemIconPadding">16dp</item>
        <item name="itemHorizontalPadding">20dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
    </style>

    <!-- 导航分组标题样式 -->
    <style name="NavigationSubheaderTextAppearance" parent="TextAppearance.AppCompat.Body2">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/nav_section_title</item>
        <item name="android:textAllCaps">false</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.03</item>
    </style>

    <!-- 夜间模式对话框主题（宿主 activity 主题是 Theme.MaterialComponents=M2，
         overlay 必须 M2 链路，M3 overlay 会解析不到属性直接闪退） -->
    <style name="Theme.Cam.MaterialAlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <!-- 对话框背景 -->
        <item name="colorSurface">#FF151A24</item>
        <!-- 标题和内容文字颜色 -->
        <item name="colorOnSurface">#FFE8ECF1</item>
        <!-- 按钮颜色 -->
        <item name="colorPrimary">#FF4D94FF</item>
        <!-- 增大字号适配车机屏幕 -->
        <item name="materialAlertDialogTitleTextStyle">@style/MaterialAlertDialog.Cam.Title</item>
        <item name="materialAlertDialogBodyTextStyle">@style/MaterialAlertDialog.Cam.Body</item>
    </style>

    <!-- 原生 AlertDialog 样式（确保文字可见） -->
    <style name="AlertDialogTheme" parent="Theme.MaterialComponents.Light.Dialog.Alert">
        <item name="android:windowBackground">#FF151A24</item>
        <item name="android:textColorPrimary">#FFE8ECF1</item>
        <item name="android:textColorSecondary">#FF8B99A8</item>
        <item name="colorPrimary">#FF4D94FF</item>
        <item name="colorOnPrimary">#FF0A0E14</item>
        <item name="buttonBarPositiveButtonStyle">@style/AlertDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/AlertDialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/AlertDialogButton</item>
    </style>

    <style name="AlertDialogButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">#FF4D94FF</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- 对话框标题字号 -->
    <style name="MaterialAlertDialog.Cam.Title" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:textSize">22sp</item>
    </style>

    <!-- 对话框正文字号 -->
    <style name="MaterialAlertDialog.Cam.Body" parent="MaterialAlertDialog.MaterialComponents.Body.Text">
        <item name="android:textSize">18sp</item>
    </style>
</resources>