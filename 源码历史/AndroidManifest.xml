<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.ahui.clustercast"
    android:versionCode="12" android:versionName="3.2.2">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="28"/>

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>

    <application android:label="@string/app_name" android:theme="@style/Theme.ClusterCast">

        <activity android:name=".MainActivity"
            android:exported="true" android:launchMode="singleTop" android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- 仪表屏极简页：只跑在 display 2，singleInstance 保证重复三指左滑不会叠出一堆任务 -->
        <activity android:name=".ClusterActivity"
            android:exported="false" android:launchMode="singleInstance"
            android:theme="@style/Theme.ClusterCast.Cluster" android:screenOrientation="landscape"/>

        <service android:name=".CastService" android:exported="false"/>

        <!-- 只为读当前媒体会话（正在放什么歌），授权一条 adb 命令即可，重启不失效 -->
        <service android:name=".MusicListener" android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService"/>
            </intent-filter>
        </service>

        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED"/>
            </intent-filter>
        </receiver>
    </application>
</manifest>
